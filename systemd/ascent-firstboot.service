[Unit]
Description=Prepare Ascent relay packages and bench services
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/ascent-relay/provisioned
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ascent-firstboot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
